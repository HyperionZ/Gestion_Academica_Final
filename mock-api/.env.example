# Copiar este archivo como .env y ajustar segun tu instalacion local de MySQL/MariaDB.
DB_HOST=localhost
DB_PORT=3306
DB_USER=idat_app
DB_PASSWORD=idat_app_2026
DB_NAME=gestion_academica

# Solo lo usa "npm run db:init" para crear la base de datos, las tablas
# y el usuario de aplicacion de arriba. No lo usa la API en tiempo de
# ejecucion. En MySQL/MariaDB recien instalado el usuario "root" suele
# autenticar solo por socket (no por password), asi que "npm run db:init"
# no puede usarlo desde Node. Crea un usuario administrador aparte:
#   mysql -u root
#   CREATE USER 'idat_admin'@'localhost' IDENTIFIED BY 'idat_admin_2026';
#   GRANT ALL PRIVILEGES ON *.* TO 'idat_admin'@'localhost' WITH GRANT OPTION;
#   FLUSH PRIVILEGES;
DB_ADMIN_USER=idat_admin
DB_ADMIN_PASSWORD=idat_admin_2026

JWT_SECRETO=idat-desarrollo-interfaces-3
JWT_VIGENCIA=2h
PUERTO=3000
